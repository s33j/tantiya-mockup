# Copy to .env.local and fill in.
# Local values: run `pnpm supabase start`, then `pnpm supabase status`.
# Hosted values: Supabase dashboard > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, never NEXT_PUBLIC_. Local: "Secret key" in `pnpm supabase status`.
# Hosted: Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=

# KYC (see README "KYC"). This app's own address: Didit's callback and the mock's
# webhook calls use it.
APP_URL=http://localhost:3000
# mock (dev only, refused in production) or didit
KYC_PROVIDER=mock
# Signs webhooks. Mock: any string. Didit: the webhook secret from its console.
DIDIT_WEBHOOK_SECRET=
# Only when KYC_PROVIDER=didit. The API key belongs to one Didit application:
# the Sandbox application's key for testing (nothing billed), the live one later.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# sandbox or live: webhooks from the other environment are ignored. Leave empty
# with the mock (its webhooks say "sandbox").
DIDIT_ENVIRONMENT=

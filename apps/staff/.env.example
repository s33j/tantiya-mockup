# Copy to .env.local and fill in.
# Local values: run `pnpm supabase start`, then `pnpm supabase status`.
# Hosted values: Supabase dashboard > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Open in Didit console" link on an application (S5). The address of any
# verification in Didit's Business Console, up to and including
# /kyc/verifications/ — different for Didit's Sandbox and Live applications.
# Not secret. Leave empty to show the Didit session id instead.
DIDIT_CONSOLE_SESSION_URL=
